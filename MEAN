import tkinter as tk
from tkinter import ttk, messagebox
import sqlite3

# Database connection
conn = sqlite3.connect("inventory.db")
cur = conn.cursor()

# Create table
cur.execute("""
CREATE TABLE IF NOT EXISTS products (
    product_id INTEGER PRIMARY KEY AUTOINCREMENT,
    product_code TEXT UNIQUE NOT NULL,
    product_name TEXT NOT NULL,
    category TEXT,
    supplier TEXT,
    price REAL,
    stock INTEGER,
    reorder_level INTEGER
)
""")

conn.commit()

# Main window
root = tk.Tk()
root.title("Product Inventory Management")
root.geometry("950x600")

# Heading
tk.Label(
    root,
    text="Product Inventory Management System",
    font=("Arial", 18, "bold")
).pack(pady=10)

# Input fields
fields = [
    "Product Code",
    "Product Name",
    "Category",
    "Supplier",
    "Price",
    "Stock",
    "Reorder Level"
]

entries = {}

form = tk.Frame(root)
form.pack()

for i, field in enumerate(fields):

    tk.Label(form, text=field).grid(
        row=i, column=0, padx=10, pady=5
    )

    entry = tk.Entry(form)
    entry.grid(row=i, column=1, padx=10, pady=5)

    entries[field] = entry


# Get input values
def get_values():

    return (
        entries["Product Code"].get(),
        entries["Product Name"].get(),
        entries["Category"].get(),
        entries["Supplier"].get(),
        float(entries["Price"].get()),
        int(entries["Stock"].get()),
        int(entries["Reorder Level"].get())
    )


# Clear fields
def clear():

    for entry in entries.values():
        entry.delete(0, tk.END)


# Insert product
def add_product():

    try:

        values = get_values()

        cur.execute("""
        INSERT INTO products
        (product_code, product_name, category,
         supplier, price, stock, reorder_level)
        VALUES (?, ?, ?, ?, ?, ?, ?)
        """, values)

        conn.commit()

        messagebox.showinfo(
            "Success",
            "Product Added Successfully"
        )

        clear()
        show_products()

    except sqlite3.IntegrityError:
        messagebox.showerror(
            "Error",
            "Product Code Already Exists"
        )

    except ValueError:
        messagebox.showerror(
            "Error",
            "Enter Valid Price and Stock Values"
        )


# Display products
def show_products():

    for row in table.get_children():
        table.delete(row)

    cur.execute("SELECT * FROM products")

    for row in cur.fetchall():
        table.insert("", tk.END, values=row)


# Delete product
def delete_product():

    selected = table.selection()

    if not selected:
        messagebox.showwarning(
            "Warning",
            "Select a product first"
        )
        return

    item = table.item(selected[0])
    product_id = item["values"][0]

    cur.execute(
        "DELETE FROM products WHERE product_id=?",
        (product_id,)
    )

    conn.commit()

    messagebox.showinfo(
        "Success",
        "Product Deleted Successfully"
    )

    show_products()
    clear()


# Search product
def search_product():

    keyword = search_entry.get()

    for row in table.get_children():
        table.delete(row)

    cur.execute("""
    SELECT * FROM products
    WHERE product_code LIKE ?
    OR product_name LIKE ?
    """, ('%' + keyword + '%', '%' + keyword + '%'))

    for row in cur.fetchall():
        table.insert("", tk.END, values=row)


# Update product
def update_product():

    selected = table.selection()

    if not selected:
        messagebox.showwarning(
            "Warning",
            "Select a product first"
        )
        return

    try:

        values = get_values()

        item = table.item(selected[0])
        product_id = item["values"][0]

        cur.execute("""
        UPDATE products SET
        product_code=?,
        product_name=?,
        category=?,
        supplier=?,
        price=?,
        stock=?,
        reorder_level=?
        WHERE product_id=?
        """, values + (product_id,))

        conn.commit()

        messagebox.showinfo(
            "Success",
            "Product Updated Successfully"
        )

        clear()
        show_products()

    except sqlite3.IntegrityError:
        messagebox.showerror(
            "Error",
            "Product Code Already Exists"
        )

    except ValueError:
        messagebox.showerror(
            "Error",
            "Enter Valid Numeric Values"
        )


# Search section
search_frame = tk.Frame(root)
search_frame.pack(pady=10)

tk.Label(
    search_frame,
    text="Search Product:"
).pack(side=tk.LEFT)

search_entry = tk.Entry(search_frame)
search_entry.pack(side=tk.LEFT, padx=5)

tk.Button(
    search_frame,
    text="Search",
    command=search_product
).pack(side=tk.LEFT)

tk.Button(
    search_frame,
    text="Show All",
    command=show_products
).pack(side=tk.LEFT, padx=5)


# Buttons
button_frame = tk.Frame(root)
button_frame.pack(pady=10)

tk.Button(
    button_frame,
    text="Add Product",
    command=add_product
).pack(side=tk.LEFT, padx=5)

tk.Button(
    button_frame,
    text="Update Product",
    command=update_product
).pack(side=tk.LEFT, padx=5)

tk.Button(
    button_frame,
    text="Delete Product",
    command=delete_product
).pack(side=tk.LEFT, padx=5)

tk.Button(
    button_frame,
    text="Clear",
    command=clear
).pack(side=tk.LEFT, padx=5)


# Product table
columns = (
    "ID", "Code", "Name", "Category",
    "Supplier", "Price", "Stock", "Reorder"
)

table = ttk.Treeview(
    root,
    columns=columns,
    show="headings"
)

for col in columns:

    table.heading(col, text=col)
    table.column(col, width=105)

table.pack(fill=tk.BOTH, expand=True, padx=10, pady=10)


# Run application
show_products()

root.mainloop()

conn.close()
