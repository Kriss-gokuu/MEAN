
import tkinter as tk
from tkinter import ttk, messagebox
import sqlite3

win = tk.Tk()
win.title("Student Management System")
win.geometry("900x550")

con = sqlite3.connect("student.db")
cur = con.cursor()

cur.execute("""
CREATE TABLE IF NOT EXISTS student(
    roll INTEGER PRIMARY KEY,
    name TEXT NOT NULL,
    age INTEGER,
    course TEXT
)
""")
con.commit()


def clear():
    roll_ent.delete(0, tk.END)
    name_ent.delete(0, tk.END)
    age_ent.delete(0, tk.END)
    course_ent.delete(0, tk.END)


def show():
    table.delete(*table.get_children())
    cur.execute("SELECT * FROM student")
    for row in cur.fetchall():
        table.insert("", tk.END, values=row)


def insert():
    if not roll_ent.get().strip() or not name_ent.get().strip():
        messagebox.showerror("Error", "Roll No and Name are required")
        return
    try:
        cur.execute(
            "INSERT INTO student VALUES(?,?,?,?)",
            (int(roll_ent.get()), name_ent.get(), age_ent.get(), course_ent.get())
        )
        con.commit()
        messagebox.showinfo("Success", "Student inserted successfully")
        show()
        clear()
    except sqlite3.IntegrityError:
        messagebox.showerror("Error", "Roll number already exists")
    except ValueError:
        messagebox.showerror("Error", "Roll No must be a number")


def update():
    if not roll_ent.get().strip():
        messagebox.showerror("Error", "Enter Roll No to update")
        return
    cur.execute(
        "UPDATE student SET name=?, age=?, course=? WHERE roll=?",
        (name_ent.get(), age_ent.get(), course_ent.get(), roll_ent.get())
    )
    con.commit()
    messagebox.showinfo("Success", "Student updated")
    show()
    clear()


def delete():
    if not roll_ent.get().strip():
        messagebox.showerror("Error", "Enter Roll No to delete")
        return
    cur.execute("DELETE FROM student WHERE roll=?", (roll_ent.get(),))
    con.commit()
    messagebox.showinfo("Success", "Student deleted")
    show()
    clear()


def search():
    table.delete(*table.get_children())
    cur.execute("SELECT * FROM student WHERE name LIKE ?", ('%' + search_ent.get() + '%',))
    for row in cur.fetchall():
        table.insert("", tk.END, values=row)


def get_data(event):
    selected = table.focus()
    if not selected:
        return
    row = table.item(selected)["values"]
    clear()
    roll_ent.insert(0, row[0])
    name_ent.insert(0, row[1])
    age_ent.insert(0, row[2])
    course_ent.insert(0, row[3])


tk.Label(win, text="STUDENT MANAGEMENT SYSTEM", font=("Arial", 16, "bold")).pack(pady=10)

form = tk.Frame(win)
form.pack(pady=5)

tk.Label(form, text="Roll No").grid(row=0, column=0, padx=5, pady=5, sticky="w")
roll_ent = tk.Entry(form, width=25)
roll_ent.grid(row=0, column=1, padx=5, pady=5)

tk.Label(form, text="Name").grid(row=1, column=0, padx=5, pady=5, sticky="w")
name_ent = tk.Entry(form, width=25)
name_ent.grid(row=1, column=1, padx=5, pady=5)

tk.Label(form, text="Age").grid(row=2, column=0, padx=5, pady=5, sticky="w")
age_ent = tk.Entry(form, width=25)
age_ent.grid(row=2, column=1, padx=5, pady=5)

tk.Label(form, text="Course").grid(row=3, column=0, padx=5, pady=5, sticky="w")
course_ent = tk.Entry(form, width=25)
course_ent.grid(row=3, column=1, padx=5, pady=5)

buttons = tk.Frame(win)
buttons.pack(pady=8)
tk.Button(buttons, text="Insert", width=12, command=insert).grid(row=0, column=0, padx=4)
tk.Button(buttons, text="Update", width=12, command=update).grid(row=0, column=1, padx=4)
tk.Button(buttons, text="Delete", width=12, command=delete).grid(row=0, column=2, padx=4)
tk.Button(buttons, text="Clear", width=12, command=clear).grid(row=0, column=3, padx=4)

search_frame = tk.Frame(win)
search_frame.pack(pady=5)
tk.Label(search_frame, text="Search Name").pack(side=tk.LEFT, padx=5)
search_ent = tk.Entry(search_frame, width=25)
search_ent.pack(side=tk.LEFT, padx=5)
tk.Button(search_frame, text="Search", command=search).pack(side=tk.LEFT, padx=4)
tk.Button(search_frame, text="Show All", command=show).pack(side=tk.LEFT, padx=4)

table = ttk.Treeview(win, columns=("roll", "name", "age", "course"), show="headings")
for col, title in zip(("roll", "name", "age", "course"), ("Roll No", "Name", "Age", "Course")):
    table.heading(col, text=title)
    table.column(col, width=180, anchor="center")
table.pack(fill="both", expand=True, padx=15, pady=10)
table.bind("<Double-1>", get_data)

show()
win.mainloop()
con.close()
