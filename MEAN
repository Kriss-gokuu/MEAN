const express = require('express');
const mongoose = require('mongoose');
const cors = require('cors');

const app = express();

app.use(cors());
app.use(express.json());

// MongoDB Connection
mongoose.connect('mongodb://localhost:27017/BookstoreDB')
.then(() => console.log("MongoDB Connected"))
.catch(err => console.log(err));

// Book Schema
const bookSchema = new mongoose.Schema({
    title: String,
    author: String,
    price: Number
});

// Book Collection
const Book = mongoose.model('Book', bookSchema, 'books');

// GET - Retrieve all books
app.get('/books', async (req, res) => {
    try {
        const books = await Book.find();

        res.json(books);

    } catch (error) {
        res.status(500).json({ message: error.message });
    }
});

// PUT - Update book details using ID
app.put('/books/:id', async (req, res) => {
    try {
        const updatedBook = await Book.findByIdAndUpdate(
            req.params.id,
            {
                title: req.body.title,
                author: req.body.author,
                price: req.body.price
            },
            { new: true, runValidators: true }
        );

        if (!updatedBook) {
            return res.status(404).json({
                message: "Book Not Found"
            });
        }

        res.json({
            message: "Book Updated Successfully",
            book: updatedBook
        });

    } catch (error) {
        res.status(400).json({ message: error.message });
    }
});

// Start Server
app.listen(3000, () => {
    console.log("Server running on port 3000");
});




HTML
<!DOCTYPE html>
<html ng-app="bookApp">

<head>
    <title>Bookstore Inventory</title>

    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular.min.js"></script>
</head>

<body ng-controller="bookCtrl">

    <h2>Bookstore Inventory Management</h2>

    <h3>Book List</h3>

    <button ng-click="getBooks()">Load Books</button>

    <table border="1" cellpadding="10">

        <tr>
            <th>Book ID</th>
            <th>Title</th>
            <th>Author</th>
            <th>Price</th>
            <th>Action</th>
        </tr>

        <tr ng-repeat="book in books">

            <td>{{book._id}}</td>
            <td>{{book.title}}</td>
            <td>{{book.author}}</td>
            <td>{{book.price}}</td>

            <td>
                <button ng-click="editBook(book)">
                    Edit
                </button>
            </td>

        </tr>

    </table>

    <hr>

    <h3>Update Book Details</h3>

    Book ID:
    <input type="text" ng-model="selectedBook._id" readonly>
    <br><br>

    Title:
    <input type="text" ng-model="selectedBook.title">
    <br><br>

    Author:
    <input type="text" ng-model="selectedBook.author">
    <br><br>

    Price:
    <input type="number" ng-model="selectedBook.price">
    <br><br>

    <button ng-click="updateBook()">
        Update Book
    </button>

    <script>

    var app = angular.module('bookApp', []);

    app.controller('bookCtrl', function($scope, $http) {

        $scope.books = [];

        // GET - Display all books
        $scope.getBooks = function() {

            $http.get('http://localhost:3000/books')
            .then(function(response) {

                $scope.books = response.data;

            });

        };

        // Select book for editing
        $scope.editBook = function(book) {

            $scope.selectedBook = angular.copy(book);

        };

        // PUT - Update book
        $scope.updateBook = function() {

            var id = $scope.selectedBook._id;

            $http.put(
                'http://localhost:3000/books/' + id,
                $scope.selectedBook
            )
            .then(function(response) {

                alert("Book Updated Successfully");

                $scope.selectedBook = {};

                $scope.getBooks();

            })
            .catch(function(error) {

                alert("Error Updating Book");

            });

        };

        // Load books initially
        $scope.getBooks();

    });

    </script>

</body>
</html>
