const express = require('express');
const mongoose = require('mongoose');
const cors = require('cors');

const app = express();

app.use(cors());
app.use(express.json());

// MongoDB Connection
mongoose.connect('mongodb://localhost:27017/BookstoreDB')
.then(() => console.log("MongoDB Connected"))
.catch(err => console.log(err));

// Book Schema
const bookSchema = new mongoose.Schema({
    title: String,
    author: String,
    price: Number
});

// Collection
const Book = mongoose.model('Book', bookSchema, 'books');


// 1. GET - Display all books
app.get('/books', async (req, res) => {
    try {
        const books = await Book.find();

        res.json(books);

    } catch (error) {
        res.status(500).send(error.message);
    }
});


// 2. POST - Add new book
app.post('/books', async (req, res) => {
    try {
        const book = new Book(req.body);

        await book.save();

        res.send("Book Added Successfully");

    } catch (error) {
        res.status(400).send(error.message);
    }
});


// 3. PUT - Update book by ID
app.put('/books/:id', async (req, res) => {
    try {
        const book = await Book.findByIdAndUpdate(
            req.params.id,
            req.body,
            { new: true, runValidators: true }
        );

        if (!book) {
            return res.status(404).send("Book Not Found");
        }

        res.json({
            message: "Book Updated Successfully",
            book: book
        });

    } catch (error) {
        res.status(400).send(error.message);
    }
});


// 4. DELETE - Delete book by ID
app.delete('/books/:id', async (req, res) => {
    try {
        const book = await Book.findByIdAndDelete(req.params.id);

        if (!book) {
            return res.status(404).send("Book Not Found");
        }

        res.send("Book Deleted Successfully");

    } catch (error) {
        res.status(400).send(error.message);
    }
});


// Start Server
app.listen(3000, () => {
    console.log("Server running on port 3000");
});


HTML

<!DOCTYPE html>
<html ng-app="bookApp">

<head>
    <title>Bookstore Management</title>

    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular.min.js"></script>

</head>

<body ng-controller="bookCtrl">

    <h2>Bookstore Inventory Management</h2>

    <hr>

    <h3>Add / Update Book</h3>

    Title:
    <input type="text" ng-model="book.title">
    <br><br>

    Author:
    <input type="text" ng-model="book.author">
    <br><br>

    Price:
    <input type="number" ng-model="book.price">
    <br><br>

    <button ng-click="addBook()" ng-if="!book._id">
        Add Book
    </button>

    <button ng-click="updateBook()" ng-if="book._id">
        Update Book
    </button>

    <button ng-click="clearForm()">
        Clear
    </button>

    <hr>

    <h3>Book List</h3>

    <button ng-click="getBooks()">
        Load Books
    </button>

    <br><br>

    <table border="1" cellpadding="10">

        <tr>
            <th>ID</th>
            <th>Title</th>
            <th>Author</th>
            <th>Price</th>
            <th>Action</th>
        </tr>

        <tr ng-repeat="b in books">

            <td>{{b._id}}</td>
            <td>{{b.title}}</td>
            <td>{{b.author}}</td>
            <td>{{b.price}}</td>

            <td>
                <button ng-click="editBook(b)">
                    Edit
                </button>

                <button ng-click="deleteBook(b._id)">
                    Delete
                </button>
            </td>

        </tr>

    </table>


    <script>

    var app = angular.module('bookApp', []);

    app.controller('bookCtrl', function($scope, $http) {

        $scope.books = [];

        $scope.book = {};


        // GET - Display Books
        $scope.getBooks = function() {

            $http.get('http://localhost:3000/books')

            .then(function(response) {

                $scope.books = response.data;

            });

        };


        // POST - Add Book
        $scope.addBook = function() {

            $http.post(
                'http://localhost:3000/books',
                $scope.book
            )

            .then(function(response) {

                alert("Book Added Successfully");

                $scope.clearForm();
                $scope.getBooks();

            });

        };


        // Select Book for Update
        $scope.editBook = function(b) {

            $scope.book = angular.copy(b);

        };


        // PUT - Update Book
        $scope.updateBook = function() {

            $http.put(
                'http://localhost:3000/books/' + $scope.book._id,
                $scope.book
            )

            .then(function(response) {

                alert("Book Updated Successfully");

                $scope.clearForm();
                $scope.getBooks();

            });

        };


        // DELETE - Delete Book
        $scope.deleteBook = function(id) {

            $http.delete(
                'http://localhost:3000/books/' + id
            )

            .then(function(response) {

                alert("Book Deleted Successfully");

                $scope.getBooks();

            });

        };


        // Clear Form
        $scope.clearForm = function() {

            $scope.book = {};

        };


        // Load Books Automatically
        $scope.getBooks();

    });

    </script>

</body>
</html>
